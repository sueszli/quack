{
    "url": "https://cad.onshape.com/documents/804927696f06d877f3f1803e/w/5b75db19292e71970de02dee/e/5e56598923b6e0d9c566370f",
    "outputFormat": "mujoco",
    "robot_name": "microduck",
    "output_filename": "robot_walk",
    "simplify_stls": true,
    "max_stl_size": 1.0,
    "ignore": {
        "*": "collision",
        "!left_foot": "collision",
        "!right_foot": "collision",
        "!leg": "collision",
        "!battery_holder": "collision"
    },
    "additional_xml": [
        "joints_properties.xml",
        "sensors.xml",
        "additional.xml"
    ],
    "post_import_commands": [
        "sed -i 's/body name=\"trunk_base\" pos=\"[^\"]*\"/body name=\"trunk_base\" pos=\"0 0 0.12\"/' robot_walk.xml",
        "sed -i '/<!-- Part left_foot_2 -->/{n; n; s/class=\"collision\"/name=\"left_foot_collision\" class=\"collision\"/}' robot_walk.xml",
        "sed -i '/<!-- Part right_foot_2 -->/{n; n; s/class=\"collision\"/name=\"right_foot_collision\" class=\"collision\"/}' robot_walk.xml",
        "sed -i '/<!-- Part leg -->/{n; n; s/class=\"collision\"/class=\"self_collision_only\"/}' robot_walk.xml",
        "sed -i '/<!-- Part leg_2 -->/{n; n; s/class=\"collision\"/class=\"self_collision_only\"/}' robot_walk.xml",
        "sed -i '/<!-- Part battery_holder -->/{n; n; s/class=\"collision\"/class=\"self_collision_only\"/}' robot_walk.xml",
        "sed -i 's/ inheritrange=\"1\"//g' robot_walk.xml",
        "sed -i 's|<site[^>]*name=\"torso_camera\"[^>]*pos=\"\\([^\"]*\\)\"[^>]*/>|&\\n      <camera name=\"torso_camera\" pos=\"\\1\" quat=\"0.5 0.5 -0.5 -0.5\"/>|' robot_walk.xml",
        "sed -i 's|<site[^>]*name=\"head_camera\"[^>]*pos=\"\\([^\"]*\\)\"[^>]*/>|&\\n              <camera name=\"head_camera\" pos=\"\\1\" quat=\"0 0 -1 0\"/>|' robot_walk.xml"
    ],
    "joint_properties": {
        "default": {
            "class": "chosen_actuator"
        },
        "passive*": {
          "actuated": false,
          "class" : "passive_joint"
        }
    }
}