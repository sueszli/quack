{
    "url": "https://cad.onshape.com/documents/804927696f06d877f3f1803e/w/3239ba0df7349fc5129ac49f/e/fde48bf18e53173cb42c1b10",
    "outputFormat": "mujoco",
    "robot_name": "microduck_parallel_neck",
    "output_filename": "robot_walk_parallel_neck",
    "simplify_stls": true,
    "max_stl_size": 1.0,
    "ignore": {
        "*": "collision",
        "!foot_tpu_bottom": "collision"
    },
    "additional_xml": [
        "joints_properties.xml",
        "sensors.xml",
        "additional.xml"
    ],
    "post_import_commands": [
        "sed -i 's/body name=\"trunk_base\" pos=\"[^\"]*\"/body name=\"trunk_base\" pos=\"0 0 0.12\"/' robot_walk_parallel_neck.xml",
        "sed -i '/<!-- Part foot_tpu_bottom -->/{n; n; s/class=\"collision\"/name=\"left_foot_collision\" class=\"collision\"/}' robot_walk_parallel_neck.xml",
        "sed -i '/<!-- Part foot_tpu_bottom_2 -->/{n; n; s/class=\"collision\"/name=\"right_foot_collision\" class=\"collision\"/}' robot_walk_parallel_neck.xml",
        "sed -i 's/ inheritrange=\"1\"//g' robot_walk_parallel_neck.xml",
        "sed -i 's|<site[^>]*name=\"torso_camera\"[^>]*pos=\"\\([^\"]*\\)\"[^>]*/>|&\\n      <camera name=\"torso_camera\" pos=\"\\1\" quat=\"0.5 0.5 -0.5 -0.5\"/>|' robot_walk_parallel_neck.xml",
        "sed -i 's|<site[^>]*name=\"head_camera\"[^>]*pos=\"\\([^\"]*\\)\"[^>]*/>|&\\n              <camera name=\"head_camera\" pos=\"\\1\" quat=\"0 0 -1 0\"/>|' robot_walk_parallel_neck.xml"
    ],
    "joint_properties": {
        "passive*": {
          "actuated": false,
          "class" : "passive_wheel"
        },
        "default": {
            "class": "chosen_actuator"
        }
    }
}