{
    "url": "https://cad.onshape.com/documents/804927696f06d877f3f1803e/w/3239ba0df7349fc5129ac49f/e/5e56598923b6e0d9c566370f",
    "outputFormat": "mujoco",
    "robot_name": "microduck",
    "output_filename": "robot_standup",
    "simplify_stls": true,
    "max_stl_size": 1.0,
    "ignore": {
        "*": "collision",
        "!left_foot": "collision",
        "!right_foot": "collision",
        "!head_shell": "collision",
        "!head_plate": "collision",
        "!jaw": "collision",
        "!head_shell_cylinder_cut": "collision",
        "!left_upper_leg": "collision",
        "!right_upper_leg": "collision",
        "!leg": "collision",
        "!NP-F970": "collision",
        "!neck_support": "collision",
    },
    "additional_xml": [
        "joints_properties.xml",
        "sensors.xml",
        "additional.xml"
    ],
    "post_import_commands": [
        "sed -i 's/body name=\"trunk_base\" pos=\"[^\"]*\"/body name=\"trunk_base\" pos=\"0 0 0.12\"/' robot_standup.xml",
        "sed -i '/<!-- Part left_foot -->/{n; n; s/class=\"collision\"/name=\"left_foot_collision\" class=\"collision\"/}' robot_standup.xml",
        "sed -i '/<!-- Part right_foot -->/{n; n; s/class=\"collision\"/name=\"right_foot_collision\" class=\"collision\"/}' robot_standup.xml",
        "sed -i 's/ inheritrange=\"1\"//g' robot_standup.xml",
        "sed -i 's|<site[^>]*name=\"torso_camera\"[^>]*pos=\"\\([^\"]*\\)\"[^>]*/>|&\\n      <camera name=\"torso_camera\" pos=\"\\1\" quat=\"0.5 0.5 -0.5 -0.5\"/>|' robot_standup.xml",
        "sed -i 's|<site[^>]*name=\"head_camera\"[^>]*pos=\"\\([^\"]*\\)\"[^>]*/>|&\\n              <camera name=\"head_camera\" pos=\"\\1\" quat=\"0 0 -1 0\"/>|' robot_standup.xml"
    ],
    "joint_properties": {
        "default": {
            "class": "chosen_actuator"
        },
        "passive*": {
          "actuated": false,
          "class" : "passive_joint"
        }
    }
}