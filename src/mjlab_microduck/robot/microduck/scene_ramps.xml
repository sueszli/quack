<mujoco model="scene">
    <include file="robot_standup.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!--
            Ramps: 2° → 14° in 2° increments, all sloping up in the +x direction.
            Fixed worldbody geoms: zero mass, fully solid for contact.

            Half-sizes: lx=0.30 (60 cm along slope), ly=0.20 (40 cm wide), lz=0.01 (2 cm thick)
            Low end of every ramp at x = 0.20 m (20 cm from robot origin).
            Ramps spaced 0.60 m apart in y (40 cm wide + 20 cm gap each).

            Position formulas — low-end TOP surface flush with z = 0 (bottom clips into ground):
              cx = 0.20 + lx·cos(θ) − lz·sin(θ)
              cz =        lx·sin(θ) − lz·cos(θ)

            Colors: green (2°) → red (14°).
        -->

        <!-- 2°  (0.0349 rad) — cx=0.500, cz=-0.003 -->
        <geom name="ramp_2deg"  type="box"
              pos="0.500 -1.80 -0.003" euler="0 -0.0349 0"
              size="0.30 0.20 0.01" rgba="0.35 0.85 0.35 1"/>

        <!-- 4°  (0.0698 rad) — cx=0.499, cz=0.004 -->
        <geom name="ramp_4deg"  type="box"
              pos="0.499 -1.20  0.004" euler="0 -0.0698 0"
              size="0.30 0.20 0.01" rgba="0.55 0.85 0.25 1"/>

        <!-- 6°  (0.1047 rad) — cx=0.497, cz=0.011 -->
        <geom name="ramp_6deg"  type="box"
              pos="0.497 -0.60  0.011" euler="0 -0.1047 0"
              size="0.30 0.20 0.01" rgba="0.75 0.85 0.15 1"/>

        <!-- 8°  (0.1396 rad) — cx=0.496, cz=0.018 -->
        <geom name="ramp_8deg"  type="box"
              pos="0.496  0.00  0.018" euler="0 -0.1396 0"
              size="0.30 0.20 0.01" rgba="0.90 0.75 0.10 1"/>

        <!-- 10° (0.1745 rad) — cx=0.494, cz=0.025 -->
        <geom name="ramp_10deg" type="box"
              pos="0.494  0.60  0.025" euler="0 -0.1745 0"
              size="0.30 0.20 0.01" rgba="0.92 0.55 0.08 1"/>

        <!-- 12° (0.2094 rad) — cx=0.491, cz=0.032 -->
        <geom name="ramp_12deg" type="box"
              pos="0.491  1.20  0.032" euler="0 -0.2094 0"
              size="0.30 0.20 0.01" rgba="0.92 0.30 0.06 1"/>

        <!-- 14° (0.2443 rad) — cx=0.489, cz=0.039 -->
        <geom name="ramp_14deg" type="box"
              pos="0.489  1.80  0.039" euler="0 -0.2443 0"
              size="0.30 0.20 0.01" rgba="0.90 0.10 0.10 1"/>

    </worldbody>

    <keyframe>
        <key name="standing" qpos="0 0 0.12 1 0 0 0 0 0 0.6 -1.2 0.6 0 0 0 0 0 0 -0.6 1.2 -0.6" ctrl="0 0 0.6 -1.2 0.6 0 0 0 0 0 0 -0.6 1.2 -0.6"/>
        <key name="sitting" qpos="0 0 0.12 1 0 0 0 0.532 0.567 -0.0089 -1.72 -0.0274 -1.22 1.23 0.00119 -0.0036 -0.533 -0.701 0.0084 1.63 0.0115" ctrl="0.532 0.567 -0.0089 -1.72 -0.0274 -1.22 1.23 0.00119 -0.0036 -0.533 -0.701 0.0084 1.63 0.0115"/>
    </keyframe>
</mujoco>
